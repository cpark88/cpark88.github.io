{
  "permissions": {
    "allow": [
      "Bash(python3 scripts/check_site.py *)",
      "Bash(python3 scripts/make_teaser.py *)",
      "Bash(python3 scripts/screenshot.py *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/check_site.py\" --hook",
            "timeout": 30,
            "statusMessage": "Checking index.html"
          }
        ]
      }
    ]
  }
}
